# Docker API through the socket proxy (dev: published on 127.0.0.1:2375)
DOCKER_HOST=tcp://127.0.0.1:2375
# Traefik API, used to confirm a new container is in the load balancer
TRAEFIK_API=http://127.0.0.1:8081
# Shared secret for callers of the engine API (the Gust worker and UI)
ENGINE_TOKEN=dev-engine-token-change-me
PORT=4100
# Dev: Traefik in Docker reaches the engine through host.docker.internal
HOST=0.0.0.0
