DATABASE_URL=postgres://gust:gust@127.0.0.1:5434/gust
ENGINE_URL=http://127.0.0.1:4100
ENGINE_TOKEN=dev-engine-token-change-me
REGISTRY_HOST=localhost:5050
# Seconds between checks that every live service still has its container
RECONCILE_EVERY_S=20

# 32 random bytes, base64: openssl rand -base64 32. Same value in web and worker.
GUST_MASTER_KEY=

# Commit statuses on GitHub through the Gust GitHub App (optional, see docs/github.md)
GITHUB_APP_ID=
# PEM, with newlines written as \n
GITHUB_APP_PRIVATE_KEY=
GUST_PUBLIC_URL=http://localhost:3100
