# Engine API (apps/engine). Server-side only; the browser never sees the token.
ENGINE_URL=http://127.0.0.1:4100
ENGINE_TOKEN=dev-engine-token-change-me
# Registry the engine pulls from; images are <REGISTRY_HOST>/<project>/<service>:<tag>
REGISTRY_URL=http://127.0.0.1:5050
REGISTRY_HOST=localhost:5050
DATABASE_URL=postgres://gust:gust@127.0.0.1:5434/gust

# Sign-in
BETTER_AUTH_URL=http://localhost:3100
# 32 random bytes, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
GUST_ADMIN_GROUP=gust-admin

# Break-glass admin, used by `pnpm --filter @gust/web auth:break-glass`
BREAK_GLASS_EMAIL=
BREAK_GLASS_PASSWORD=

# 32 random bytes, base64: openssl rand -base64 32. Same value in web and worker.
GUST_MASTER_KEY=

# Deploys from GitHub Actions (POST /api/deploy)
# Must match the action's `audience` input.
GITHUB_OIDC_AUDIENCE=gust.zephyron.tech
# Owners (orgs or users) whose repositories may deploy, comma-separated
GITHUB_ALLOWED_OWNERS=Zephyron-Tech
# Links handed to GitHub; defaults to BETTER_AUTH_URL
GUST_PUBLIC_URL=
# Dev only: accept tokens from `pnpm --filter @gust/web dev:oidc`. Ignored in production.
GITHUB_OIDC_DEV_JWKS=
