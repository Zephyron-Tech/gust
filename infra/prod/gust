#!/usr/bin/env bash
# Day-to-day commands for Gust on the server. Installed as /usr/local/bin/gust.
#
#   gust status                 containers and their state
#   gust logs [service]         follow logs (web, engine, worker, traefik, zot, postgres)
#   gust update                 pull the latest Gust image and restart
#   gust restart [service]      restart everything or one service
#   gust project <args>         add and change projects (gust project help)
#   gust break-glass            create or reset the break-glass admin from .env
#   gust registry               credentials GitHub Actions push with
#   gust backup                 dump the database to $GUST_DIR/backups (keeps 14 days)
#   gust restore <file>         restore a dump (asks first)
set -euo pipefail

GUST_DIR="${GUST_DIR:-/opt/gust}"
cd "$GUST_DIR"

# Reads one value from .env without sourcing it.
envval() { sed -n "s/^$1=//p" .env | head -n1 | sed -e 's/^"//' -e 's/"$//'; }

dc() { docker compose --project-directory "$GUST_DIR" "$@"; }

image() { envval GUST_IMAGE || true; }

# compose.yml, the Traefik and Zot config and this script come from the
# image, so an update brings them along.
sync_files() {
  local img cid
  img="$(image)"
  img="${img:-ghcr.io/zephyron-tech/gust:latest}"
  cid="$(docker create "$img")"
  mkdir -p traefik zot
  docker cp "$cid:/gust/infra/prod/compose.yml" compose.yml
  docker cp "$cid:/gust/infra/prod/traefik/dynamic.yml" traefik/dynamic.yml
  docker cp "$cid:/gust/infra/prod/zot/config.json" zot/config.json
  docker cp "$cid:/gust/infra/prod/gust" gust.new
  docker rm "$cid" >/dev/null
  chmod +x gust.new && mv gust.new gust
}

# Update requests from the web UI. The web container only writes request files
# in $GUST_DIR/requests and reads status.json; this runs on the host, started by
# systemd (gust-requests.path and gust-version-check.timer).
REQ="$GUST_DIR/requests"
STATUS="$REQ/status.json"

img_ref() { local i; i="$(image)"; echo "${i:-ghcr.io/zephyron-tech/gust:latest}"; }

# Digest of the image on this host, and of the newest one on the registry.
digest_local() {
  docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$(img_ref)" 2>/dev/null \
    | sed -n 's/^.*@\(sha256:[a-f0-9]*\)$/\1/p' | head -n1 || true
}
digest_remote() {
  # A timeout, so a stuck registry request cannot leave the UI waiting forever.
  timeout 60 docker buildx imagetools inspect "$(img_ref)" --format '{{.Manifest.Digest}}' 2>/dev/null | head -n1 || true
}

# write_status <state> <action> <current> <latest> [error]
write_status() {
  local avail=false err="${5:-}"
  [ -n "$3" ] && [ -n "$4" ] && [ "$3" != "$4" ] && avail=true
  printf '{"state":"%s","action":"%s","current":"%s","latest":"%s","available":%s,"checkedAt":"%s","error":"%s"}\n' \
    "$1" "$2" "$3" "$4" "$avail" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$err" > "$STATUS.tmp"
  chmod 644 "$STATUS.tmp"
  mv "$STATUS.tmp" "$STATUS"
}

# Reads one string field of status.json, empty when there is no file yet.
prev_field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" "$STATUS" 2>/dev/null | head -n1 || true; }

# Refreshes the version fields and keeps the last install result (timer and check).
refresh_status() {
  local st act
  st="$(prev_field state)"; act="$(prev_field action)"
  write_status "${st:-idle}" "${act:-none}" "$(digest_local)" "$(digest_remote)"
}

requests_run() {
  mkdir -p "$REQ"
  if [ -f "$REQ/install" ]; then
    rm -f "$REQ/install" "$REQ/check"
    write_status running install "$(digest_local)" "$(digest_remote)"
    local state=failed
    # A backup first, so a bad update can be restored with gust restore.
    if { "$GUST_DIR/gust" backup && "$GUST_DIR/gust" update; } >"$REQ/update.log" 2>&1; then state=ok; fi
    write_status "$state" install "$(digest_local)" "$(digest_remote)"
  elif [ -f "$REQ/check" ]; then
    rm -f "$REQ/check"
    # Shows "checking" in the UI right away, then the result or the error.
    write_status running check "$(digest_local)" ""
    local latest
    latest="$(digest_remote)"
    if [ -n "$latest" ]; then
      write_status idle check "$(digest_local)" "$latest"
    else
      write_status failed check "$(digest_local)" "" "Could not read the image from the registry. Run: journalctl -u gust-requests.service -n 50"
    fi
  fi
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  status)
    dc ps
    ;;
  logs)
    dc logs -f --tail 200 "$@"
    ;;
  update)
    img="$(image)"
    docker pull "${img:-ghcr.io/zephyron-tech/gust:latest}"
    sync_files
    dc up -d --remove-orphans
    echo "Gust updated."
    ;;
  restart)
    dc restart "$@"
    ;;
  up)
    dc up -d --remove-orphans
    ;;
  project)
    dc run --rm -T migrate project "$@"
    ;;
  break-glass)
    dc run --rm -T -e BREAK_GLASS_EMAIL="$(envval BREAK_GLASS_EMAIL)" -e BREAK_GLASS_PASSWORD="$(envval BREAK_GLASS_PASSWORD)" migrate break-glass
    ;;
  registry)
    echo "Registry:  $(envval REGISTRY_DOMAIN)"
    echo "Username:  ci"
    echo "Password:  $(envval REGISTRY_CI_PASSWORD)"
    echo
    echo "Put them into GitHub as organisation secrets GUST_REGISTRY_USERNAME and GUST_REGISTRY_PASSWORD."
    ;;
  backup)
    mkdir -p backups
    file="backups/gust-$(date +%Y-%m-%d-%H%M).sql.gz"
    dc exec -T postgres pg_dump -U gust --no-owner gust | gzip > "$file.tmp"
    mv "$file.tmp" "$file"
    find backups -name 'gust-*.sql.gz' -mtime +14 -delete
    # The Settings page reads this to show when the last backup was taken.
    mkdir -p "$REQ"
    printf '{"at":"%s","file":"%s","bytes":%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(basename "$file")" "$(stat -c %s "$file")" \
      > "$REQ/backup.json.tmp"
    mv "$REQ/backup.json.tmp" "$REQ/backup.json"
    echo "$GUST_DIR/$file"
    ;;
  restore)
    file="${1:?usage: gust restore <file.sql.gz>}"
    [ -f "$file" ] || { echo "No such file: $file" >&2; exit 1; }
    read -r -p "Replace the Gust database with $file? Type yes: " answer
    [ "$answer" = yes ] || { echo "Cancelled."; exit 1; }
    gunzip -t "$file" || { echo "$file is not a readable backup" >&2; exit 1; }
    # Web and worker come back up whatever happens below.
    trap 'dc start web worker >/dev/null' EXIT
    dc stop web worker
    # A fresh database, then the dump: pg-boss uses partitioned tables that a
    # dump's own DROP statements cannot remove.
    dc exec -T postgres psql -q -U gust -d postgres -v ON_ERROR_STOP=1 \
      -c 'DROP DATABASE IF EXISTS gust WITH (FORCE)' -c 'CREATE DATABASE gust OWNER gust'
    gunzip -c "$file" | dc exec -T postgres psql -q -U gust -d gust -v ON_ERROR_STOP=1 >/dev/null
    echo "Restored."
    ;;
  sync-files)
    sync_files
    ;;
  version-check)
    refresh_status
    ;;
  requests-run)
    requests_run
    ;;
  help | -h | --help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Unknown command: $cmd (gust help)" >&2
    exit 64
    ;;
esac
