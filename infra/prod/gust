#!/usr/bin/env bash
# Day-to-day commands for Gust on the server. Installed as /usr/local/bin/gust.
#
#   gust status                 containers and their state
#   gust logs [service]         follow logs (web, engine, worker, traefik, zot, postgres)
#   gust update                 pull the latest Gust image and restart
#   gust restart [service]      restart everything or one service
#   gust project <args>         add and change projects (gust project help)
#   gust break-glass            create or reset the break-glass admin from .env
#   gust registry               credentials GitHub Actions push with
#   gust backup                 dump the database to $GUST_DIR/backups (keeps 14 days)
#   gust restore <file>         restore a dump (asks first)
set -euo pipefail

GUST_DIR="${GUST_DIR:-/opt/gust}"
cd "$GUST_DIR"

# Reads one value from .env without sourcing it.
envval() { sed -n "s/^$1=//p" .env | head -n1 | sed -e 's/^"//' -e 's/"$//'; }

# Secrets added after the first install. A server installed before Redis
# gets its password here, on the next update or up.
ensure_env() {
  if ! grep -q '^REDIS_PASSWORD=' .env; then
    printf '\n# Password of the shared Redis service (docs/databases.md).\nREDIS_PASSWORD=%s\n' \
      "$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40)" >> .env
    echo "Added REDIS_PASSWORD to .env."
  fi
}

dc() { docker compose --project-directory "$GUST_DIR" "$@"; }

image() { envval GUST_IMAGE || true; }

# compose.yml, the Traefik and Zot config and this script come from the
# image, so an update brings them along.
sync_files() {
  local img cid
  img="$(image)"
  img="${img:-ghcr.io/zephyron-tech/gust:latest}"
  cid="$(docker create "$img")"
  mkdir -p traefik zot
  docker cp "$cid:/gust/infra/prod/compose.yml" compose.yml
  docker cp "$cid:/gust/infra/prod/traefik/dynamic.yml" traefik/dynamic.yml
  docker cp "$cid:/gust/infra/prod/zot/config.json" zot/config.json
  docker cp "$cid:/gust/infra/prod/gust" gust.new
  docker rm "$cid" >/dev/null
  chmod +x gust.new && mv gust.new gust
}

# Update requests from the web UI. The web container only writes request files
# in $GUST_DIR/requests and reads status.json; this runs on the host, started by
# systemd (gust-requests.path and gust-version-check.timer).
REQ="$GUST_DIR/requests"
STATUS="$REQ/status.json"

img_ref() { local i; i="$(image)"; echo "${i:-ghcr.io/zephyron-tech/gust:latest}"; }

# Digest of the image on this host, and of the newest one on the registry.
digest_local() {
  docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$(img_ref)" 2>/dev/null \
    | sed -n 's/^.*@\(sha256:[a-f0-9]*\)$/\1/p' | head -n1 || true
}
digest_remote() {
  # A timeout, so a stuck registry request cannot leave the UI waiting forever.
  timeout 60 docker buildx imagetools inspect "$(img_ref)" --format '{{.Manifest.Digest}}' 2>/dev/null | head -n1 || true
}

# write_status <state> <action> <current> <latest> [error]
write_status() {
  local avail=false err="${5:-}"
  [ -n "$3" ] && [ -n "$4" ] && [ "$3" != "$4" ] && avail=true
  printf '{"state":"%s","action":"%s","current":"%s","latest":"%s","available":%s,"checkedAt":"%s","error":"%s"}\n' \
    "$1" "$2" "$3" "$4" "$avail" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$err" > "$STATUS.tmp"
  chmod 644 "$STATUS.tmp"
  mv "$STATUS.tmp" "$STATUS"
}

# Sends a line to the Discord webhook in .env. Silent when none is set.
notify() {
  local url body
  url="$(envval DISCORD_WEBHOOK_URL)"
  [ -n "$url" ] || return 0
  body="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  curl -fsS -m 10 -H 'content-type: application/json' -d "{\"content\":\"$body\"}" "$url" >/dev/null \
    || echo "Discord alert failed" >&2
}

# Reads one string field of status.json, empty when there is no file yet.
prev_field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" "$STATUS" 2>/dev/null | head -n1 || true; }

# Refreshes the version fields and keeps the last install result (timer and check).
refresh_status() {
  local st act was current latest
  st="$(prev_field state)"; act="$(prev_field action)"
  was="$(grep -c '"available":true' "$STATUS" 2>/dev/null || true)"
  current="$(digest_local)"; latest="$(digest_remote)"
  write_status "${st:-idle}" "${act:-none}" "$current" "$latest"
  # Alert once, when a newer image first shows up, not on every check.
  if [ -n "$current" ] && [ -n "$latest" ] && [ "$current" != "$latest" ] && [ "${was:-0}" = 0 ]; then
    notify "New Gust version available on the registry. Install it from Settings."
  fi
}

# Samples the host for the Server page: CPU and steal over one second, RAM, disk,
# network, load and the containers. Runs every minute from gust-metrics.timer.
# Files in $REQ: metrics.json (latest), metrics.jsonl (30 days, one line a minute),
# containers.jsonl (docker stats) and containers.txt (name|restarts|labels).
sample_metrics() {
  mkdir -p "$REQ"
  local cpu_a cpu_b net_a net_b t1 i1 s1 t2 i2 s2 rx1 tx1 rx2 tx2 stamp
  cpu_a="$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8+$9, $5+$6, $9}' /proc/stat)"
  net_a="$(awk 'NR>2 && $1 !~ /^lo:/ {rx+=$2; tx+=$10} END {print rx+0, tx+0}' /proc/net/dev)"
  sleep 1
  cpu_b="$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8+$9, $5+$6, $9}' /proc/stat)"
  net_b="$(awk 'NR>2 && $1 !~ /^lo:/ {rx+=$2; tx+=$10} END {print rx+0, tx+0}' /proc/net/dev)"
  read -r t1 i1 s1 <<<"$cpu_a"
  read -r t2 i2 s2 <<<"$cpu_b"
  read -r rx1 tx1 <<<"$net_a"
  read -r rx2 tx2 <<<"$net_b"
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local line
  line="$(awk -v t=$((t2-t1)) -v i=$((i2-i1)) -v s=$((s2-s1)) -v rx=$((rx2-rx1)) -v tx=$((tx2-tx1)) \
    -v ld="$(awk '{print $1}' /proc/loadavg)" '
    BEGIN {
      printf "{\"cpu\":%.1f,\"steal\":%.1f,\"load1\":%s,\"netInMBps\":%.2f,\"netOutMBps\":%.2f", \
        (t>0 ? (t-i)*100/t : 0), (t>0 ? s*100/t : 0), ld, rx/1000000, tx/1000000
    }' )"
  line="$line$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END {printf ",\"ramUsedGb\":%.2f,\"ramTotalGb\":%.2f", (t-a)/1048576, t/1048576}' /proc/meminfo)"
  line="$line$(df -B1 --output=used,size / | tail -n1 | awk '{printf ",\"diskUsedGb\":%.2f,\"diskTotalGb\":%.2f", $1/1073741824, $2/1073741824}')"
  line="$line,\"uptimeSec\":$(awk '{printf "%d", $1}' /proc/uptime),\"at\":\"$stamp\"}"
  printf '%s\n' "$line" > "$REQ/metrics.json.tmp" && mv "$REQ/metrics.json.tmp" "$REQ/metrics.json"
  printf '%s\n' "$line" >> "$REQ/metrics.jsonl"
  if [ "$(wc -l < "$REQ/metrics.jsonl")" -gt 44640 ]; then
    tail -n 43200 "$REQ/metrics.jsonl" > "$REQ/metrics.jsonl.tmp" && mv "$REQ/metrics.jsonl.tmp" "$REQ/metrics.jsonl"
  fi
  docker stats --no-stream --format '{{json .}}' > "$REQ/containers.jsonl.tmp" 2>/dev/null || : > "$REQ/containers.jsonl.tmp"
  mv "$REQ/containers.jsonl.tmp" "$REQ/containers.jsonl"
  local ids
  ids="$(docker ps -aq 2>/dev/null || true)"
  if [ -n "$ids" ]; then
    docker inspect --format '{{.Name}}|{{.RestartCount}}|{{index .Config.Labels "gust.project"}}|{{index .Config.Labels "com.docker.compose.project"}}' $ids > "$REQ/containers.txt.tmp" 2>/dev/null || : > "$REQ/containers.txt.tmp"
  else
    : > "$REQ/containers.txt.tmp"
  fi
  mv "$REQ/containers.txt.tmp" "$REQ/containers.txt"
}

# How many tags the registry keeps, read from its own config so Settings shows the real value.
registry_status() {
  mkdir -p "$REQ"
  local keep
  keep="$(sed -n 's/.*"mostRecentlyPushedCount": *\([0-9]*\).*/\1/p' "$GUST_DIR/zot/config.json" 2>/dev/null | head -n1)"
  if [ -n "$keep" ]; then
    printf '{"keepTags":%s,"at":"%s"}\n' "$keep" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$REQ/registry.json.tmp"
  else
    printf '{"keepTags":null,"at":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$REQ/registry.json.tmp"
  fi
  mv "$REQ/registry.json.tmp" "$REQ/registry.json"
}

# What the Settings page shows about this machine, read from the host itself.
server_status() {
  mkdir -p "$REQ"
  local os vcpu ram disk uptime
  os="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}" | tr -d '"\\')"
  vcpu="$(nproc)"
  ram="$(awk '/MemTotal/ {printf "%d", $2 / 1048576 + 0.5}' /proc/meminfo)"
  disk="$(df -B1 --output=size / | tail -n1 | awk '{printf "%d", $1 / 1073741824 + 0.5}')"
  uptime="$(awk '{printf "%d", $1}' /proc/uptime)"
  printf '{"os":"%s","vcpu":%s,"ramGb":%s,"diskGb":%s,"uptimeSec":%s,"at":"%s"}\n' \
    "$os" "$vcpu" "$ram" "$disk" "$uptime" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$REQ/server.json.tmp"
  mv "$REQ/server.json.tmp" "$REQ/server.json"
}

requests_run() {
  mkdir -p "$REQ"
  if [ -f "$REQ/install" ]; then
    rm -f "$REQ/install" "$REQ/check"
    write_status running install "$(digest_local)" "$(digest_remote)"
    local state=failed
    # A backup first, so a bad update can be restored with gust restore.
    if { "$GUST_DIR/gust" backup && "$GUST_DIR/gust" update; } >"$REQ/update.log" 2>&1; then state=ok; fi
    write_status "$state" install "$(digest_local)" "$(digest_remote)"
    if [ "$state" = failed ]; then notify "Gust update failed on $(hostname). Log: $REQ/update.log"; fi
  elif [ -f "$REQ/check" ]; then
    rm -f "$REQ/check"
    # Shows "checking" in the UI right away, then the result or the error.
    write_status running check "$(digest_local)" ""
    local latest
    latest="$(digest_remote)"
    if [ -n "$latest" ]; then
      write_status idle check "$(digest_local)" "$latest"
    else
      write_status failed check "$(digest_local)" "" "Could not read the image from the registry. Run: journalctl -u gust-requests.service -n 50"
      notify "Gust could not read the registry on $(hostname). Run: journalctl -u gust-requests.service -n 50"
    fi
  fi
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  status)
    dc ps
    ;;
  logs)
    dc logs -f --tail 200 "$@"
    ;;
  update)
    img="$(image)"
    docker pull "${img:-ghcr.io/zephyron-tech/gust:latest}"
    sync_files
    ensure_env
    dc up -d --remove-orphans
    echo "Gust updated."
    ;;
  restart)
    dc restart "$@"
    ;;
  up)
    ensure_env
    dc up -d --remove-orphans
    ;;
  project)
    dc run --rm -T migrate project "$@"
    ;;
  break-glass)
    dc run --rm -T -e BREAK_GLASS_EMAIL="$(envval BREAK_GLASS_EMAIL)" -e BREAK_GLASS_PASSWORD="$(envval BREAK_GLASS_PASSWORD)" migrate break-glass
    ;;
  registry)
    echo "Registry:  $(envval REGISTRY_DOMAIN)"
    echo "Username:  ci"
    echo "Password:  $(envval REGISTRY_CI_PASSWORD)"
    echo
    echo "Put them into GitHub as organisation secrets GUST_REGISTRY_USERNAME and GUST_REGISTRY_PASSWORD."
    ;;
  backup)
    mkdir -p backups
    file="backups/gust-$(date +%Y-%m-%d-%H%M).sql.gz"
    if ! dc exec -T postgres pg_dump -U gust --no-owner gust | gzip > "$file.tmp"; then
      rm -f "$file.tmp"
      notify "Gust backup failed on $(hostname). Run: sudo gust backup"
      exit 1
    fi
    mv "$file.tmp" "$file"
    find backups -name 'gust-*.sql.gz' -mtime +14 -delete
    # The Settings page reads this to show when the last backup was taken.
    mkdir -p "$REQ"
    printf '{"at":"%s","file":"%s","bytes":%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(basename "$file")" "$(stat -c %s "$file")" \
      > "$REQ/backup.json.tmp"
    mv "$REQ/backup.json.tmp" "$REQ/backup.json"
    # Heartbeat: a healthchecks.io URL in .env gets a ping after each good backup.
    # No ping means the check goes late, which is the alert.
    hb="$(envval HEARTBEAT_URL)"
    if [ -n "$hb" ]; then curl -fsS -m 10 --retry 2 "$hb" >/dev/null || echo "Heartbeat ping failed" >&2; fi
    echo "$GUST_DIR/$file"
    ;;
  restore)
    file="${1:?usage: gust restore <file.sql.gz>}"
    [ -f "$file" ] || { echo "No such file: $file" >&2; exit 1; }
    read -r -p "Replace the Gust database with $file? Type yes: " answer
    [ "$answer" = yes ] || { echo "Cancelled."; exit 1; }
    gunzip -t "$file" || { echo "$file is not a readable backup" >&2; exit 1; }
    # Web and worker come back up whatever happens below.
    trap 'dc start web worker >/dev/null' EXIT
    dc stop web worker
    # A fresh database, then the dump: pg-boss uses partitioned tables that a
    # dump's own DROP statements cannot remove.
    dc exec -T postgres psql -q -U gust -d postgres -v ON_ERROR_STOP=1 \
      -c 'DROP DATABASE IF EXISTS gust WITH (FORCE)' -c 'CREATE DATABASE gust OWNER gust'
    gunzip -c "$file" | dc exec -T postgres psql -q -U gust -d gust -v ON_ERROR_STOP=1 >/dev/null
    echo "Restored."
    ;;
  sync-files)
    sync_files
    ;;
  version-check)
    refresh_status
    server_status
    registry_status
    ;;
  sample)
    sample_metrics
    ;;
  requests-run)
    requests_run
    ;;
  help | -h | --help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Unknown command: $cmd (gust help)" >&2
    exit 64
    ;;
esac
