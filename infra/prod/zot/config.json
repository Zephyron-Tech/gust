{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h",
    "retention": {
      "delay": "24h",
      "policies": [{ "repositories": ["**"], "deleteReferrers": true, "keepTags": [{ "mostRecentlyPushedCount": 20 }] }]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "realm": "gust",
    "auth": { "htpasswd": { "path": "/etc/zot/htpasswd" }, "failDelay": 1 },
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [{ "users": ["ci"], "actions": ["read", "create", "update", "delete"] }, { "users": ["gust"], "actions": ["read"] }],
          "defaultPolicy": []
        }
      }
    }
  },
  "log": { "level": "info" }
}
