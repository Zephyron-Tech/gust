{
  "name": "gust",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:engine": "pnpm --filter @gust/engine dev",
    "infra:up": "docker compose -f infra/compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/compose.dev.yml down",
    "infra:demo": "for v in v1 v2; do docker build -q --build-arg VERSION=$v -t localhost:5050/demo/hello:$v infra/demo-app && docker push -q localhost:5050/demo/hello:$v; done",
    "spike:bluegreen": "pnpm --filter @gust/engine spike:bluegreen",
    "db:generate": "pnpm --filter @gust/db db:generate",
    "db:migrate": "pnpm --filter @gust/db db:migrate",
    "db:seed": "pnpm --filter @gust/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
